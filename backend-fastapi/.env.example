# Escolhe uma das duas formas de configuração PostgreSQL.
# DATABASE_URL tem prioridade, se estiver definida:
DATABASE_URL=postgresql+psycopg://taskflow:altere-esta-senha@localhost:5432/taskflow

# Alternativamente, configura estas variáveis em vez de DATABASE_URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=taskflow_db
# DB_USER=taskflow
# DB_PASSWORD=altere-esta-senha

# Sem DATABASE_URL nem variáveis DB_*, o backend usa SQLite localmente.
# Gere um segredo único e aleatório antes de publicar a aplicação.
TOKEN_SECRET=altere-por-um-segredo-aleatorio-longo
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
